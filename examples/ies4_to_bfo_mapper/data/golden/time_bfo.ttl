@prefix data: <http://example.org/rdf/data/> .
@prefix obo: <http://purl.obolibrary.org/obo/> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

data:participant_a a obo:BFO_0000015 ;  # Process
    obo:BFO_0000132 data:event_a ;  # occurrent part of event_a at some time
    obo:BFO_0000132 data:person_a_history .  # occurrent part of person_a's history

data:20240101 a obo:BFO_0000038 ;  # One-dimensional temporal region
    rdfs:label "2024-01-01"^^xsd:string .

data:event_a a obo:BFO_0000015 ;  # Process
    obo:BFO_0000199 data:20240101 .  # occupies temporal region

data:person_a a obo:BFO_0000030 .  # Object

data:person_a_history a obo:BFO_0000182 ;  # History
    obo:BFO_0000184 data:person_a ;  # history of
    obo:BFO_0000200 data:person_a_spacetime .  # occupies spatiotemporal region

data:person_a_spacetime a obo:BFO_0000011 .  # Spatiotemporal region
