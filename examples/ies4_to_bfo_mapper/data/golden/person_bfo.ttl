@prefix data: <http://example.org/rdf/data/> .
@prefix obo: <http://purl.obolibrary.org/obo/> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

data:person_a_history a obo:BFO_0000182 ;  # History
    obo:BFO_0000184 data:person_a ;  # history of
    obo:BFO_0000200 data:person_a_spacetime .  # occupies spatiotemporal region

data:person_a a obo:BFO_0000030 ;  # Object
    rdfs:label "Person A"^^xsd:string .

data:person_a_spacetime a obo:BFO_0000011 .  # Spatiotemporal region
