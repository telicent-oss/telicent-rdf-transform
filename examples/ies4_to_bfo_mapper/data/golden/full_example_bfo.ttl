@prefix cco: <https://www.commoncoreontologies.org/> .
@prefix data: <http://example.org/rdf/data/> .
@prefix obo: <http://purl.obolibrary.org/obo/> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

data:Alice_Smith_history a obo:BFO_0000182 ;  # History
    obo:BFO_0000184 data:Alice_Smith ;  # history of
    obo:BFO_0000200 data:Alice_Smith_spacetime .  # occupies spatiotemporal region

data:Alice_Smith_name a cco:ont00000003 ;
    obo:BFO_0000084 data:Alice_Smith_name_ibe ;  # generically depends on
    cco:ont_00001916 data:Alice_Smith .  # designates

data:Alice_in_meeting a obo:BFO_0000015 ;  # Process
    obo:BFO_0000132 data:important_meeting ;  # occurrent part of meeting
    obo:BFO_0000132 data:Alice_Smith_history .  # occurrent part of alices history

data:HR_attends_meeting a obo:BFO_0000015 ;  # Process
    obo:BFO_0000132 data:important_meeting ;  # occurrent part of meeting
    obo:BFO_0000132 data:HR_department_history .  # occurrent part of

data:organisation_ABC_history a obo:BFO_0000182 ;  # History
    obo:BFO_0000184 data:organisation_ABC ;  # history of
    obo:BFO_0000200 data:organisation_ABC_spacetime .  # occupies spatiotemporal region

data:organisation_ABC_id a cco:ont00000077 ;
    obo:BFO_0000084 data:organisation_ABC_id_ibe ;  # generically depends on
    cco:ont_00001916 data:organisation_ABC .  # designates

data:Alice_Smith_name_ibe a cco:ont_00000253 ;  # Information Bearing Entity
    cco:ont_00001765 "Alice Smith"^^xsd:string .  # has text value

data:Alice_Smith_spacetime a obo:BFO_0000011 .  # Spatiotemporal region

data:Alice_Smith_state a obo:BFO_0000015 ;  # Process
    obo:BFO_0000132 data:Alice_Smith_history .  # occurrent part of

data:HR_department a obo:BFO_0000027 ;  # Object aggregate
    obo:BFO_0000175 data:organisation_ABC .  # continuant part of

data:HR_department_history a obo:BFO_0000182 ;  # History
    obo:BFO_0000184 data:HR_department ;  # history of
    obo:BFO_0000200 data:HR_department_spacetime .  # occupies spatiotemporal region

data:HR_department_spacetime a obo:BFO_0000011 .  # Spatiotemporal region

data:organisation_ABC_id_ibe a cco:ont_00000253 ;  # Information Bearing Entity
    cco:ont_00001765 "ABC123"^^xsd:string .  # has text value

data:organisation_ABC_spacetime a obo:BFO_0000011 .  # Spatiotemporal region

data:Alice_Smith a obo:BFO_0000030 .  # Object

data:important_meeting a obo:BFO_0000015 ;  # Process
    rdfs:label "Important HR Meeting with Alice Smith"^^xsd:string .

data:organisation_ABC a obo:BFO_0000027 ;  # Object aggregate
    rdfs:label "Organisation ABC"^^xsd:string .