@prefix data: <http://example.org/rdf/data/> .
@prefix obo:  <http://purl.obolibrary.org/obo/> .
@prefix cco:  <https://www.commoncoreontologies.org/> .
@prefix xsd:  <http://www.w3.org/2001/XMLSchema#> .

# The person
data:alice              a    obo:BFO_0000030 .  # object

# The name — Designative Name (CCO subclass of Designative ICE)
data:alice_name         a    cco:ont00000003 ;      # Designative Name
    obo:BFO_0000084     data:alice_name_ibe ;        # generically depends on
    cco:ont_00001916    data:alice .                 # designates

data:alice_name_ibe     a    cco:ont_00000253 ;     # Information Bearing Entity
    cco:ont_00001765    "Alice Smith"^^xsd:string .  # has text value

# The identifier — Non-Name Identifier (CCO subclass of Designative ICE)
data:alice_id           a    cco:ont00000077 ;      # Non-Name Identifier
    obo:BFO_0000084     data:alice_id_ibe ;          # generically depends on
    cco:ont_00001916    data:alice .                 # designates

data:alice_id_ibe       a    cco:ont_00000253 ;     # Information Bearing Entity
    cco:ont_00001765    "ID-123456"^^xsd:string .    # has text value

# Generic representation — Designative ICE (no more specific type known)
data:alice_rep          a    cco:ont_00000686 ;     # Designative ICE
    obo:BFO_0000084     data:alice_rep_ibe ;         # generically depends on
    cco:ont_00001916    data:alice .                 # designates

data:alice_rep_ibe      a    cco:ont_00000253 ;     # Information Bearing Entity
    cco:ont_00001765    "Some representation"^^xsd:string .  # has text value