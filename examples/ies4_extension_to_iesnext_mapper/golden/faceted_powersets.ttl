# Faceted classification with powersets (extending-ies.md, "Complex Extensions"). IES 4.3 has
# no ies:ClassOfDevice; the powerset hierarchy hangs off ies:ClassOfAsset, the powerset of ies:Asset.
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix ies_tport: <http://purl.org/ies/tport/v0/ont/> .
@prefix ont: <http://example.com/local-ontology#> .

ont:ClassOfShip a skos:Collection ;
    skos:member ont:ClassOfFunctionalUseOfShip,
        ont:ClassOfPoweredShip .

ont:ClassOfFunctionalUseOfShip a skos:Collection ;
    skos:member ont:PassengerShip,
        ont:CargoShip .

ont:ClassOfPoweredShip a skos:Collection ;
    skos:member ont:WindPoweredShip,
        ont:NuclearPoweredShip .

ont:PassengerShip a skos:Concept ;
    skos:broader ies_tport:Ship .

ont:CargoShip a skos:Concept ;
    skos:broader ies_tport:Ship .

ont:WindPoweredShip a skos:Concept ;
    skos:broader ies_tport:Ship .

ont:NuclearPoweredShip a skos:Concept ;
    skos:broader ies_tport:Ship .
