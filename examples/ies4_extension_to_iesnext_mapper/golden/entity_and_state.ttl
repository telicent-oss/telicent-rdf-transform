# A new entity with its own state class (extending-ies.md, "Specific guidance for
# extending Entities"). The entity is a subclass of both the IES4 entity and its new state.
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix ies_core: <http://purl.org/ies/core/v0/ont/> .
@prefix ies_top: <http://purl.org/ies/top/v0/ont/> .
@prefix ont_next: <http://example.com/local-ontology-next#> .

ont_next:Submarine a skos:Concept ;
    skos:broader ies_core:Vehicle,
        ont_next:SubmarineState .

ont_next:SubmarineState a skos:Concept ;
    skos:broader ies_top:State .

ont_next:Submerged a skos:Concept ;
    skos:broader ont_next:SubmarineState .
