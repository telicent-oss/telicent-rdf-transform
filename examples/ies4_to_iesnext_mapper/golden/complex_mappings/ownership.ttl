@prefix data: <http://example.org/rdf/data/> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix ies: <http://ies.data.gov.uk/ontology/ies4#> .
@prefix ies_top: <http://purl.org/ies/top/v0/ont/> .
@prefix ies_core: <http://purl.org/ies/core/v0/ont/> .

data:house_001 a ies_core:RealEstate .

data:owner_of_house_001 a ies_top:State .


data:house_001_ownership_activity a ies_core:LegalOwnership .

data:house_001_legally_owned a ies_core:LegallyOwned ;
    ies_top:isTemporalPartOf data:house_001 ;
    ies_top:isPartOf data:house_001_ownership_activity .

data:house_001_legal_owner a ies_core:LegalOwner ;
    ies_top:isPartOf data:house_001_ownership_activity ;
    ies_top:isTemporalPartOf data:owner_of_house_001 .






   