@prefix data: <http://example.org/rdf/data/> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix ies: <http://ies.data.gov.uk/ontology/ies4#> .
@prefix ies_top: <http://purl.org/ies/top/v0/ont/> .
@prefix ies_core: <http://purl.org/ies/core/v0/ont/> .
@prefix iso8601: <http://iso.org/iso8601#> .
@prefix ies_social: <http://purl.org/ies/social/v0/ont/> .


# person ownership
data:house_001 a ies_core:RealEstate .

data:person_001 a ies_core:Person .
data:person_002 a ies_core:Person .
data:characteristic_001 a ies_core:Characteristic .
data:location_house_001 a ies_core:Location .

data:friend_of_person_001 a ies_top:State ;
    ies_top:isTemporalPartOf data:person_002 .

data:owner_of_house_001 a ies_top:State ;
    ies_top:isTemporalPartOf data:person_001 ;
    ies_core:hasCharacteristic data:characteristic_001 ;
    ies_top:isPartOf data:location_house_001 ;
    ies_social:friendOf data:friend_of_person_001 .

data:moving_in_house_001 a ies_top:State ;
    ies_top:isAStartOf data:owner_of_house_001 ;
    ies_top:isPartOf iso8601:20240301 .

data:moving_out_house_001 a ies_top:State ;
    ies_top:isAFinishOf data:owner_of_house_001 ;
    ies_top:isPartOf iso8601:20260301 .

iso8601:20240301 a ies_core:ParticularPeriod ;
    ies_core:iso8601PeriodRepresentation "2024-03-01"^^xsd:string .

iso8601:20260301 a ies_core:ParticularPeriod ;
    ies_core:iso8601PeriodRepresentation "2026-03-01"^^xsd:string .

data:house_001_ownership_activity a ies_core:LegalOwnership ;
    ies_top:isPartOf data:location_house_001 .

data:moving_in_house_001_ownership a ies_top:State ;
    ies_top:isAStartOf data:house_001_ownership_activity ;
    ies_top:isPartOf iso8601:20240301 .

data:moving_out_house_001_ownership a ies_top:State ;
    ies_top:isAFinishOf data:house_001_ownership_activity ;
    ies_top:isPartOf iso8601:20260301 .

data:house_001_legally_owned a ies_core:LegallyOwned ;
    ies_top:isTemporalPartOf data:house_001 ;
    ies_top:isPartOf data:house_001_ownership_activity .

data:house_001_legal_owner a ies_core:LegalOwner ;
    ies_top:isPartOf data:house_001_ownership_activity ;
    ies_top:isTemporalPartOf data:person_001 .

# organisation ownership

data:vehicle_001 a ies_core:Vehicle .

data:organisation_001 a ies_core:Organization .
data:location_001 a ies_core:Location .

data:vehicle_001_ownership_activity a ies_core:LegalOwnership ;
    ies_top:isPartOf iso8601:2010 ;
    ies_top:isPartOf data:location_001 .


iso8601:2010 a ies_core:ParticularPeriod ;
    ies_core:iso8601PeriodRepresentation "2010"^^xsd:string .

data:vehicle_001_legally_owned a ies_core:LegallyOwned ;
    ies_top:isTemporalPartOf data:vehicle_001 ;
    ies_top:isPartOf data:vehicle_001_ownership_activity .

data:vehicle_001_legal_owner a ies_core:LegalOwner ;
    ies_top:isPartOf data:vehicle_001_ownership_activity ;
    ies_top:isTemporalPartOf data:organisation_001 .
